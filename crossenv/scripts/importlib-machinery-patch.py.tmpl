_original_find_spec = PathFinder.find_spec

# well after the bootstrap process, and before we've patched, so it's safe to
# import normally here
import os
import sys

# Resolve the stdlib path from `os.__file__` instead of asking sysconfig.
#
# On Python 3.14, sysconfig deferred `_init_config_vars` to first call. If
# `_PathFinder_find_spec` is the first thing to call `sysconfig.get_path`,
# that triggers `_init_posix` -> `_get_sysconfigdata` -> `import_module(...)`
# -> `PathFinder.find_spec` (us again) -> `sysconfig.get_path()` -> recursion
# into half-initialized sysconfig, raising `AttributeError: 'installed_base'`
# from `_subst_vars` because `_CONFIG_VARS` hasn't been populated yet.
#
# We can't pre-resolve via sysconfig either: crossenv's `sysconfig-patch`
# asserts `_CONFIG_VARS is None` at patch time, so initializing sysconfig
# here breaks that patch's invariant downstream.
#
# `os.__file__` is the path to the loaded `os.py` from the build interpreter's
# stdlib, and every standard CPython layout places that file at
# `<stdlib>/os.py`. By the time this template runs `os` has already been
# imported (see crossenv's site.py), so `os.__file__` is available and
# stable for the lifetime of the interpreter.
_STDLIB_PATH = os.path.dirname(os.path.abspath(os.__file__))

@classmethod
def _PathFinder_find_spec(cls, fullname, path=None, target=None):
    """Monkey patch to PathFinder.find_spec that silently inserts
    sys.build_path just prior to the stdlib. We do this so that
    pip/setuptools/etc don't consider packages installed for build-python when
    deciding what to download and build. We need to be careful to allow
    prepending to sys.path to take priority for pip's isolated build
    environments."""

    if path is None:
        path = list(sys.path)
        try:
            i = path.index(_STDLIB_PATH)
            path[i:i] = sys.build_path
        except ValueError:
            pass

    return _original_find_spec(fullname, path, target)
PathFinder.find_spec = _PathFinder_find_spec

EXTENSION_SUFFIXES = [{{repr(self.sysconfig_ext_suffix)}}, ".abi3.so", ".so"]
