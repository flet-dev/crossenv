def mac_ver(release='', versioninfo=('', '', ''), machine=''):
    if release == '':
        release = {{repr(macosx_deployment_target)}}
    if machine == '':
        machine = _uname_result.machine
    return release, versioninfo, machine

IOSVersionInfo = collections.namedtuple(
    "IOSVersionInfo",
    ["system", "release", "model", "is_simulator"]
)

def ios_ver(system="", release="", model="", is_simulator=False):
    if system == "":
        system = {{repr(self.host_system)}}
    if release == "":
        release = {{repr(self.host_release)}}
    if model == "":
        model = {{repr("iPhone" if self.host_is_simulator else "iPhone13,2")}}

    return IOSVersionInfo(system, release, model, {{repr(self.host_is_simulator)}})

AndroidVer = collections.namedtuple(
    "AndroidVer", "release api_level manufacturer model device is_emulator")

def android_ver(release="", api_level=0, manufacturer="", model="", device="",
                is_emulator=False):

    import sysconfig
    platform_parts = sysconfig.get_platform().split("-")

    release = {{repr(self.host_release)}}
    api_level = int(platform_parts[1])
    manufacturer = "Google"
    model = "Android"
    device = "Pixel"
    is_emulator = "1" if is_emulator else "0"

    return AndroidVer(
        release, api_level, manufacturer, model, device, is_emulator)

